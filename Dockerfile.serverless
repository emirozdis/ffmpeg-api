# syntax=docker/dockerfile:1.7

FROM node:20-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:20-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg python3 python3-venv tini \
    && ffmpeg -hide_banner -encoders 2>/dev/null | grep -q '[[:space:]]h264_nvenc[[:space:]]' \
    && python3 -m venv /opt/pyworker-venv \
    && /opt/pyworker-venv/bin/pip install --no-cache-dir --upgrade pip \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 transcoder \
    && useradd --system --uid 10001 --gid transcoder --home-dir /app --shell /usr/sbin/nologin transcoder

ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="MyTurn Vast Serverless GPU Transcoder" \
      org.opencontainers.image.description="Vast PyWorker with an NVENC HLS backend and Cloudflare R2 integration" \
      org.opencontainers.image.source="https://github.com/emirozdis/ffmpeg-api" \
      org.opencontainers.image.revision="$VCS_REF"

WORKDIR /app

ENV NODE_ENV=production \
    HOST=127.0.0.1 \
    PORT=3000 \
    WORKER_PORT=5000 \
    WORKER_HTTP_PORT=5001 \
    MODEL_LOG_FILE=/data/logs/model.log \
    ENABLE_VAST_SERVERLESS=true \
    UPLOAD_DIR=/data/uploads \
    PROCESSED_DIR=/data/processed \
    STATE_DIR=/data/state \
    LOG_FILE_PATH=/data/logs/app.log \
    VIDEO_ENCODER=h264_nvenc \
    NVENC_PRESET=p3 \
    NVENC_TUNE=hq \
    REQUIRE_NVENC=true \
    REQUIRE_CUDA_PIPELINE=true \
    CUDA_DEVICE=0 \
    GPU_TELEMETRY_INTERVAL_MS=5000 \
    MAX_CONCURRENT_JOBS=1 \
    MAX_CONCURRENT_JOBS_CAP=1 \
    AUTO_SCALE_CONCURRENCY=false \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

COPY requirements.txt ./
RUN /opt/pyworker-venv/bin/pip install --no-cache-dir -r requirements.txt

COPY --from=build --chown=transcoder:transcoder /app/package.json /app/package-lock.json ./
COPY --from=build --chown=transcoder:transcoder /app/node_modules ./node_modules
COPY --from=build --chown=transcoder:transcoder /app/dist ./dist
COPY --chown=transcoder:transcoder worker.py ./worker.py
COPY --chmod=755 docker/entrypoint-serverless.sh /usr/local/bin/entrypoint-serverless

RUN mkdir -p /data/uploads /data/processed /data/state /data/logs \
    && chown -R transcoder:transcoder /data /app

USER transcoder
EXPOSE 5000 5001

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-serverless"]
