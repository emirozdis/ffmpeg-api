# syntax=docker/dockerfile:1.7

FROM node:20-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:20-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg tini \
    && ffmpeg -hide_banner -encoders 2>/dev/null | grep -q '[[:space:]]h264_nvenc[[:space:]]' \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 transcoder \
    && useradd --system --uid 10001 --gid transcoder --home-dir /app --shell /usr/sbin/nologin transcoder

ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="MyTurn GPU Transcoder" \
      org.opencontainers.image.description="Always-on NVENC HLS transcoding API for a stable GPU instance" \
      org.opencontainers.image.source="https://github.com/emirozdis/ffmpeg-api" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.variant="vast-stable"

WORKDIR /app

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    ENABLE_VAST_SERVERLESS=false \
    REQUIRE_RUNTIME_CONFIG=true \
    UPLOAD_DIR=/data/uploads \
    PROCESSED_DIR=/data/processed \
    STATE_DIR=/data/state \
    LOG_FILE_PATH=/data/logs/app.log \
    VIDEO_ENCODER=h264_nvenc \
    NVENC_PRESET=p3 \
    NVENC_TUNE=hq \
    REQUIRE_NVENC=true \
    REQUIRE_CUDA_PIPELINE=true \
    CUDA_DEVICE=0 \
    CUDA_DECODE_MODE=auto \
    GPU_TELEMETRY_INTERVAL_MS=5000 \
    MAX_CONCURRENT_JOBS=1 \
    MAX_CONCURRENT_JOBS_CAP=1 \
    AUTO_SCALE_CONCURRENCY=false \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,video,utility

COPY --from=build --chown=transcoder:transcoder /app/package.json /app/package-lock.json ./
COPY --from=build --chown=transcoder:transcoder /app/node_modules ./node_modules
COPY --from=build --chown=transcoder:transcoder /app/dist ./dist
COPY --chmod=755 docker/entrypoint-gpu.sh /usr/local/bin/entrypoint-gpu

RUN mkdir -p /data/uploads /data/processed /data/state /data/logs \
    && chown -R transcoder:transcoder /data /app

USER transcoder
EXPOSE 3000
VOLUME ["/data/state"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||'3000')+'/api/v1/system/health',{headers:{'x-api-key':process.env.API_KEY||''}}).then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-gpu"]
CMD ["node", "dist/index.js"]
