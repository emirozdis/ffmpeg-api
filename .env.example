PORT=3000
HOST=0.0.0.0
API_KEY=replace_with_a_separate_32_byte_random_api_key
TRANSCODER_WEBHOOK_SECRET=replace_with_a_separate_32_byte_random_webhook_secret
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=vlogs
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed
# Must be on durable storage so jobs survive restarts/deploys.
STATE_DIR=./storage/state
# Comma-separated exact origins. Production has no permissive default.
TRANSCODER_ALLOWED_WEBHOOK_ORIGINS=https://myturn.app

# HLS encoder. Use h264_nvenc on Vast.ai; libx264 remains the CPU-safe default.
VIDEO_ENCODER=libx264
NVENC_PRESET=p4
NVENC_TUNE=hq

# A single job consumes three NVENC sessions (1080p, 720p, and 480p).
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_JOBS_CAP=1
AUTO_SCALE_CONCURRENCY=false

# Vast Serverless image defaults. WORKER_PORT is normally injected by Vast.
ENABLE_VAST_SERVERLESS=false
WORKER_PORT=5000
WORKER_HTTP_PORT=5001
MODEL_LOG_FILE=/data/logs/model.log
PYWORKER_MAX_QUEUE_TIME=1800
